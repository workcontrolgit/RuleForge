[
  {
    "WorkflowName": "Transfer",
    "Rules": [
      {
        "RuleName": "BalanceControl",
        "SuccessEvent": "10",
        "ErrorMessage": "You do not have sufficient funds for this transaction.",
        "ErrorType": "Error",
        "RuleExpressionType": "LambdaExpression",
        "Expression": "input1.Balance >= input2.Amount"
      },
      {
        "RuleName": "UnderZero",
        "SuccessEvent": "10",
        "ErrorMessage": "The balance must be a valid number.",
        "ErrorType": "Error",
        "RuleExpressionType": "LambdaExpression",
        "Expression": "CustomMethods.UnderOrEqualsZero(input2.Amount) == false"
      }
    ]
  },
  {
    "WorkflowName": "PositionWorkflow",
    "Rules": [
      {
        "RuleName": "Apply10PercentDiscount",
        "SuccessEvent": "10% Discount Applied",
        "ErrorMessage": "No discount applicable",
        "Expression": "input1.TotalAmount < 100"
      },
      {
        "RuleName": "Apply20PercentDiscount",
        "SuccessEvent": "20% Discount Applied",
        "ErrorMessage": "No discount applicable",
        "Expression": "input2 == \"PositionWorkflow\""
      }
    ]
  },
  {
    "WorkflowName": "PositionWorkflow2",
    "Rules": [
      {
        "RuleName": "Apply10PercentDiscount2",
        "SuccessEvent": "10% Discount Applied",
        "ErrorMessage": "No discount applicable",
        "Expression": "basicInfo.TotalAmount > 100"
      },
      {
        "RuleName": "Apply20PercentDiscount2",
        "SuccessEvent": "20% Discount Applied",
        "ErrorMessage": "No discount applicable",
        "Expression": "orderInfo == \"PositionWorkflow\""
      }
    ]
  },
  {
    "WorkflowName": "RuleParameterWorkflow",
    "Rules": [
      {
        "RuleName": "Apply10PercentDiscount",
        "SuccessEvent": "10% Discount Applied",
        "ErrorMessage": "No discount applicable",
        "Expression": "positionInfo.TotalAmount > 100"
      }
    ]
  },
  {
    "WorkflowName": "RuleSet1",
    "Rules": [
      {
        "RuleName": "Age Check",
        "SuccessEvent": "10% Discount Applied",
        "ErrorMessage": "No discount applicable",
        "Expression": "metadata.Dimensions.Age  > 100"
      },
      {
        "RuleName": "Discount Rule",
        "SuccessEvent": "10% Discount Applied",
        "ErrorMessage": "No discount applicable",
        "Expression": "metadata.Dimensions.PurchaseAmount > 100"
      }
    ]
  },
  {
    "WorkflowName": "my_workflow",
    "Rules": [
      {
        "RuleName": "MatchesFabrikam",
        "SuccessEvent": "does match",
        "ErrorMessage": "does not match",
        "Expression": "myValue.Value1 == \"Fabrikam\""
      }
    ]
  },
  {
    "WorkflowName": "DiscountWithCustomInputNames",
    "Rules": [
      {
        "RuleName": "GiveDiscount10",
        "Expression": "basicInfo.country == \"india\" AND basicInfo.loyalityFactor <= 2 AND basicInfo.totalPurchasesToDate >= 5000 AND orderInfo.totalOrders > 2 AND telemetryInfo.noOfVisitsPerMonth > 2"
      },
      {
        "RuleName": "GiveDiscount20",
        "Expression": "basicInfo.country == \"india\" AND basicInfo.loyalityFactor == 3 AND basicInfo.totalPurchasesToDate >= 10000 AND orderInfo.totalOrders > 2 AND telemetryInfo.noOfVisitsPerMonth > 2"
      }
    ]
  }
